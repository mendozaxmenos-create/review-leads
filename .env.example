# Google Places API (New) — https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# OpenAI — clasificación de reseñas
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# SQLite + caché local
DATABASE_PATH=data/review-leads.db
CACHE_TTL_HOURS=24

# Geocodificación (OpenStreetMap Nominatim pide un email de contacto)
NOMINATIM_CONTACT_EMAIL=

# Remitente de mensajes de outreach (WhatsApp, email, bot de ventas)
OUTREACH_SENDER_NAME=Gustavo
OUTREACH_SENDER_COMPANY=SofIA

# Producción Fly/Render: usar DATABASE_PATH=/tmp/review-leads.db
# Local con persistencia: DATABASE_PATH=data/review-leads.db (default arriba)
