# Google Places API (New) — https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# OpenAI — clasificación de reseñas
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# SQLite + caché local
DATABASE_PATH=data/review-leads.db
CACHE_TTL_HOURS=24

# Geocodificación (OpenStreetMap Nominatim pide un email de contacto)
NOMINATIM_CONTACT_EMAIL=

# Remitente de mensajes de outreach (WhatsApp, email, bot de ventas)
OUTREACH_SENDER_NAME=Gustavo
OUTREACH_SENDER_COMPANY=SofIA

# --- Twilio WhatsApp Business (envío automático) ---
# Seguir skills del plugin Twilio Developer Kit:
#   twilio-account-setup → twilio-whatsapp-send-message → twilio-whatsapp-manage-senders
#   → twilio-content-template-builder
#
# FASE A — Sandbox (probar YA, sin Meta/WABA):
# 1. Cuenta Twilio → Account SID + Auth Token
# 2. Console > Messaging > Try it out > Send a WhatsApp message (activar Sandbox)
# 3. Desde TU celular: enviá "join <código>" al +14155238886
# 4. TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# 5. Usá una plantilla preaprobada del Sandbox (Content SID en la consola), ej. appointment reminder
# 6. Probar: python -m scripts.send_mendoza_whatsapp --live --limit 1
#    (solo llega a números que hicieron join; throttle 1 msg / 3s)
#
# FASE B — Producción (blast Mendoza ~250 leads limpios):
# 1. Upgrade cuenta Twilio (trial no registra sender prod)
# 2. Registrar WhatsApp sender +54 (skill twilio-whatsapp-manage-senders)
# 3. Plantilla MARKETING {{1}}=nombre, {{2}}=zona, precio fijo $19.000/mes → Meta Approved
#    (scripts/create_wa_template.py)
# 4. TWILIO_WHATSAPP_FROM=whatsapp:+549...  TWILIO_TEMPLATE_SID=HXxxxx
# 5. TWILIO_SEND_ENABLED=true
# 6. Webhook inbound público → /api/twilio/whatsapp/inbound
# 7. Dashboard: /campaign · lotes: scripts/send_mendoza_batches.py
# 8. Resto programado: scripts/run_mendoza_remaining.bat (tarea SofIA-Mendoza-WA-Rest)
#
# Docs: https://www.twilio.com/docs/whatsapp/sandbox
#       https://www.twilio.com/docs/content
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_TEMPLATE_SID=
TWILIO_SEND_ENABLED=false
TWILIO_SEND_DELAY_SECONDS=3

# Webhook respuestas (Twilio Console → WhatsApp Sandbox/Sender → When a message comes in):
#   https://<tu-dominio-o-ngrok>/api/twilio/whatsapp/inbound
# Tras la 1ª respuesta del lead: marcar responded y seguir en tu WhatsApp personal (wa.me), no por Twilio.
# --- Demo pública para leads (pitch WhatsApp) ---
# NUNCA pegues http://127.0.0.1 en el pitch: el lead no puede abrirlo.
#
# Opción A — Render (recomendada, gratis):
#   1. Deploy desde el mirror público en render.com
#   2. DEMO_PUBLIC_URL=https://review-leads.onrender.com   (sin /demo al final)
#   3. Pitch: https://review-leads.onrender.com/demo  (público, sin token)
#   4. DASHBOARD_ACCESS_TOKEN=<secreto> → /campaign?k=… y /admin?k=… (solo vos)
#
# Opción B — Túnel temporal (cloudflared / ngrok) mientras tu PC está encendida:
#   cloudflared tunnel --url http://127.0.0.1:8000
#   DEMO_PUBLIC_URL=https://xxxx.trycloudflare.com
#
DEMO_PUBLIC_URL=
# Legacy (ignorado): la demo ya no exige token
DEMO_ACCESS_TOKEN=
# Protege /campaign y /admin (y sus APIs). Dejá vacío en local.
DASHBOARD_ACCESS_TOKEN=

# --- Avisos cuando un lead entra a «Por contestar (humano)» ---
# Se dispara en el webhook inbound (misma PC/túnel que recibe Twilio).
# Solo al pasar a Prioridad (no en cada mensaje humano siguiente).
ALERT_ON_HUMAN_REPLY=true
# WhatsApp a tu celular (mismo número Twilio de campaña; fuera de ventana 24h puede fallar)
ALERT_WHATSAPP_TO=
# Email (recomendado como backup fiable)
ALERT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Link que aparece en el aviso
ALERT_DASHBOARD_URL=http://127.0.0.1:8000/campaign

# Producción Fly/Render: usar DATABASE_PATH=/tmp/review-leads.db
# Local con persistencia: DATABASE_PATH=data/review-leads.db (default arriba)
